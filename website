@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#0F1730;--surface:#18234A;--ink:#EAEEF9;--muted:#A6B1D1;--accent:#FF7094;--rule:#2B3868}}
:root[data-theme="dark"]{--bg:#0F1730;--surface:#18234A;--ink:#EAEEF9;--muted:#A6B1D1;--accent:#FF7094;--rule:#2B3868}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font:400 1.125rem/1.7 "Source Serif 4",Georgia,serif}
a{color:inherit}
:focus-visible{outline:3px solid var(--accent);outline-offset:3px}
[hidden]{display:none!important}
.wrap{max-width:46rem;margin:0 auto;padding:0 1.25rem}
h1,h2,h3,nav{font-family:"Bricolage Grotesque","Helvetica Neue",Arial,sans-serif}
header{border-bottom:1px solid var(--rule)}
nav{display:flex;align-items:center;gap:1.25rem;padding:.9rem 0;flex-wrap:wrap;font-weight:500;font-size:1rem}
nav .brand{display:flex;align-items:center;gap:.6rem;font-weight:800;text-decoration:none;margin-right:auto}
nav .brand svg{width:2.4rem;height:2.4rem}
nav a:not(.brand){text-decoration:none;color:var(--muted);padding:.1rem 0}
nav a:not(.brand):hover{color:var(--ink)}
nav a[aria-current="page"]{color:var(--ink);border-bottom:2px solid var(--accent)}
.hero{padding:4.5rem 0 3rem}
h1{font-size:clamp(2.6rem,9vw,4.6rem);line-height:1.02;letter-spacing:-.02em;font-weight:800;margin:0 0 1.5rem}
.page-title{font-size:clamp(2.2rem,7vw,3.2rem);margin:3rem 0 1.5rem}
.blank{font:inherit;color:var(--accent);background:none;border:0;border-bottom:.09em dashed var(--accent);padding:0 .1em;cursor:pointer;min-width:2.2em;text-align:left;letter-spacing:inherit}
.dots span{display:inline-block;animation:b 1.4s infinite}
.dots span:nth-child(2){animation-delay:.2s}.dots span:nth-child(3){animation-delay:.4s}
@keyframes b{0%,60%,100%{opacity:.25}30%{opacity:1}}
@media (prefers-reduced-motion:reduce){.dots span{animation:none}}
.lede{max-width:34rem;color:var(--muted);margin:0 0 1rem}
.hint{font-size:.95rem;color:var(--muted);font-style:italic}
section{padding:2.5rem 0;border-top:1px solid var(--rule)}
.view{padding-bottom:3rem}
h2{font-size:1.7rem;letter-spacing:-.01em;margin:0 0 1.2rem}
dl{margin:0}
dt{font-family:"Bricolage Grotesque",sans-serif;font-weight:700;font-size:1.2rem;margin-top:1.4rem}
dt:first-child{margin-top:0}
dd{margin:.15rem 0 0;color:var(--muted);max-width:36rem}
.feed{list-style:none;padding:0;margin:0}
.feed li{display:flex;gap:1rem;align-items:baseline;padding:.8rem 0;border-bottom:1px solid var(--rule)}
.feed li:last-child{border-bottom:0}
.feed .len{font:700 .9rem "Bricolage Grotesque",sans-serif;background:var(--sun);color:#14213D;border-radius:99px;padding:.05rem .7rem;white-space:nowrap}
.host{display:grid;gap:1rem;margin-top:2rem}
.host p{margin:0}
.photo{width:8rem;height:8rem;border-radius:50%;background:var(--surface);border:1px solid var(--rule);display:grid;place-items:center;color:var(--muted);font:500 .85rem "Bricolage Grotesque",sans-serif;text-align:center}
@media (min-width:40rem){.host{grid-template-columns:8rem 1fr;gap:2rem}}
.fill{display:inline-block;min-width:6.5em;border-bottom:2px dashed var(--accent);color:var(--muted);font-style:italic;text-align:center;padding:0 .3em;line-height:1.3}
.follow{display:flex;gap:.75rem;flex-wrap:wrap}
.follow a{font:700 1rem "Bricolage Grotesque",sans-serif;text-decoration:none;padding:.6rem 1.2rem;border-radius:.4rem;border:2px solid var(--ink)}
.follow a:first-child{background:var(--ink);color:var(--bg)}
.follow a:hover{border-color:var(--accent)}
.grid{display:grid;gap:1.25rem;grid-template-columns:repeat(auto-fill,minmax(14rem,1fr));margin-bottom:1rem}
.grid.wide{grid-template-columns:repeat(auto-fill,minmax(19rem,1fr))}
.vid a{display:inline-block;margin-top:.5rem;font:700 .95rem "Bricolage Grotesque",sans-serif}
.frame{position:relative;width:100%;background:var(--surface);border:1px solid var(--rule);border-radius:.5rem;overflow:hidden}
.frame.short{aspect-ratio:9/16}.frame.long{aspect-ratio:16/9}
.frame iframe{position:absolute;inset:0;width:100%;height:100%;border:0}
.more{font:700 1rem "Bricolage Grotesque",sans-serif}
footer{padding:2rem 0 3rem;color:var(--muted);font-size:.95rem;border-top:1px solid var(--rule)}
</style>
</head>
<body>
