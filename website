<script>
(function(){
/* ADD YOUR VIDEOS HERE. Paste full links between the quotes, separated by commas, newest first.
   TikTok example:  "https://www.tiktok.com/@yourname/video/7123456789012345678"
   YouTube example: "https://www.youtube.com/watch?v=abcdefghijk" (youtu.be and /shorts/ links also work) */
var VIDEOS={
tiktok:[],
youtube:[]
};
var NAMES={tiktok:"TikTok",youtube:"YouTube"};
function vidId(kind,u){var m=kind==="tiktok"?u.match(/video\/(\d+)/):u.match(/(?:v=|youtu\.be\/|shorts\/|embed\/)([\w-]{11})/);return m&&m[1];}
function card(kind,url){
var id=vidId(kind,url);if(!id)return null;
var d=document.createElement("div");d.className="vid";
var f=document.createElement("div");f.className="frame "+(kind==="tiktok"?"short":"long");
var i=document.createElement("iframe");
i.src=kind==="tiktok"?"https://www.tiktok.com/embed/v2/"+id:"https://www.youtube-nocookie.com/embed/"+id;
i.title=NAMES[kind]+" video";i.loading="lazy";i.allowFullscreen=true;
i.setAttribute("allow","encrypted-media; picture-in-picture; fullscreen");
f.appendChild(i);d.appendChild(f);
var a=document.createElement("a");a.href=url;a.target="_blank";a.rel="noopener";a.textContent="Watch on "+NAMES[kind];
d.appendChild(a);return d;}
function empty(el,text){var p=document.createElement("p");p.className="hint";p.textContent=text;el.appendChild(p);}
function fill(id,kind){var el=document.getElementById(id);el.textContent="";var n=0;
VIDEOS[kind].forEach(function(u){var c=card(kind,u);if(c){el.appendChild(c);n++;}});
if(!n)empty(el,"Coming soon. Add "+NAMES[kind]+" links to the VIDEOS list in this page\u2019s code.");}
fill("tt","tiktok");fill("yt","youtube");
var hl=document.getElementById("highlights"),all=[];hl.textContent="";
VIDEOS.tiktok.forEach(function(u){all.push(["tiktok",u]);});
VIDEOS.youtube.forEach(function(u){all.push(["youtube",u]);});
all.slice(0,3).forEach(function(x){var c=card(x[0],x[1]);if(c)hl.appendChild(c);});
if(!hl.children.length)empty(hl,"Our first videos are coming soon.");
var words=["tongue","lengua","langue","Zunge","lingua","舌"],i=0,b=document.getElementById("blank");
b.addEventListener("click",function(){i=(i+1)%words.length;b.textContent=words[i];});
var names=["home","series","videos","follow"];
function route(){
var h=location.hash.replace("#","");if(names.indexOf(h)<0)h="home";
names.forEach(function(n){document.getElementById("v-"+n).hidden=(n!==h);});
document.querySelectorAll("[data-nav]").forEach(function(a){
if(a.dataset.nav===h)a.setAttribute("aria-current","page");else a.removeAttribute("aria-current");});
window.scrollTo(0,0);
}
window.addEventListener("hashchange",route);route();
})();
</script>
